################################################################################
# ~/.chezmoi.toml.tmpl
# Chezmoi configuration (template)
# Supports: macOS, Linux, Windows
################################################################################

[data]
    name = "{{ promptString "name" }}"
    email = "{{ promptString "email" }}"
{{- if eq .chezmoi.os "darwin" }}
    keepassdb = "/Users/{{ .chezmoi.username }}/Dropbox/PW.kdbx"
{{- end }}

    # Opt-in: install EPFL VPN helpers (epfl, epfl-ssh shell functions).
    # Requires openconnect + keepassxc + macOS Keychain entry "keepassxc-master".
    # Defaults to ON for macOS, OFF for Linux/Windows (e.g. Citadel workstations).
    # Change later by editing ~/.config/chezmoi/chezmoi.toml and running `chezmoi apply`.
    epfl_vpn = {{ promptBoolOnce . "epfl_vpn" "Install EPFL VPN helpers" (eq .chezmoi.os "darwin") }}

[diff]
    pager = "delta"

[merge]
    command = "vimdiff"

################################################################################
# OS Detection Flags
################################################################################

[data.macos]
    enabled = {{ eq .chezmoi.os "darwin" }}

[data.linux]
    enabled = {{ eq .chezmoi.os "linux" }}

[data.windows]
    enabled = {{ eq .chezmoi.os "windows" }}

################################################################################
# KeePassXC Integration (macOS only)
################################################################################
{{- if eq .chezmoi.os "darwin" }}

[keepassxc]
    args = ["--all"]
    database = "/Users/{{ .chezmoi.username }}/Dropbox/PW.kdbx"
{{- end }}
