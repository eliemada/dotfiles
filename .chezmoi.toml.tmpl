################################################################################
# ~/.chezmoi.toml.tmpl
# Chezmoi configuration (template)
# Supports: macOS, Linux, Windows
################################################################################

[data]
    name = "{{ promptStringOnce . "name" "Full name" }}"
    email = "{{ promptStringOnce . "email" "Git email (work address on work machines)" }}"
{{- if eq .chezmoi.os "darwin" }}
    keepassdb = "/Users/{{ .chezmoi.username }}/Dropbox/PW.kdbx"
{{- end }}

    # Opt-in: install EPFL VPN helpers (epfl, epfl-ssh shell functions).
    # Requires openconnect + keepassxc + macOS Keychain entry "keepassxc-master".
    # Defaults to ON for macOS, OFF for Linux/Windows (e.g. the QRT workstation).
    # Change later by editing ~/.config/chezmoi/chezmoi.toml and running `chezmoi apply`.
    epfl_vpn = {{ promptBoolOnce . "epfl_vpn" "Install EPFL VPN helpers" (eq .chezmoi.os "darwin") }}

    # Opt-in: personal-life MCP servers for Claude Code (moodle + edstem).
    # Secrets come from KeePassXC on macOS, promptStringOnce elsewhere.
    # Defaults to ON for macOS, OFF for Linux/Windows.
    personal_mcps = {{ promptBoolOnce . "personal_mcps" "Install personal MCP servers (moodle + edstem)" (eq .chezmoi.os "darwin") }}

    # Opt-in: work MCP servers for Claude Code (Atlassian + Slack stealth).
    # Defaults to OFF everywhere (only if a work machine allows these MCPs).
    work_mcps = {{ promptBoolOnce . "work_mcps" "Install work MCP servers (Atlassian + Slack)" false }}

################################################################################
# Claude MCP secrets (non-macOS only)
# On macOS we read from KeePassXC at apply time via `keepassxcAttribute`.
# On Linux/Windows we have no native vault helper baked into chezmoi, so we
# capture the secrets once at `chezmoi init` and persist them in this file.
# CAUTION: ~/.config/chezmoi/chezmoi.toml will then contain plaintext secrets
# (mode 0600, never committed). For corp environments swap this block for
# `[secret]` + a custom secretCommand calling op/keeper/secret-tool.
################################################################################
{{- $is_other := ne .chezmoi.os "darwin" -}}
{{- $personal := false -}}{{- if hasKey . "personal_mcps" }}{{ $personal = .personal_mcps }}{{ end -}}
{{- $work := false -}}{{- if hasKey . "work_mcps" }}{{ $work = .work_mcps }}{{ end -}}

{{- if and $is_other (or $personal $work) }}
[data.claude_secrets]
{{- if and $is_other $personal }}
    [data.claude_secrets.moodle]
        URL      = "{{ promptStringOnce . "claude_moodle_url"      "Moodle domain (e.g. moodle.epfl.ch)" }}"
        Password = "{{ promptStringOnce . "claude_moodle_token"    "Moodle API token" }}"
    [data.claude_secrets.edstem]
        Password = "{{ promptStringOnce . "claude_edstem_token"  "Ed (edstem.org) API token" }}"
        URL      = "{{ promptStringOnce . "claude_edstem_region" "Ed region (eu or us)" }}"
{{- end }}
{{- if and $is_other $work }}
    [data.claude_secrets.atlassian]
        URL      = "{{ promptStringOnce . "claude_atlassian_url"   "Atlassian URL (https://yourorg.atlassian.net)" }}"
        UserName = "{{ promptStringOnce . "claude_atlassian_email" "Atlassian email" }}"
        Password = "{{ promptStringOnce . "claude_atlassian_token" "Atlassian API token" }}"
    [data.claude_secrets.slack]
        xoxc_token = "{{ promptStringOnce . "claude_slack_xoxc" "Slack xoxc browser token (starts with xoxc-)" }}"
        xoxd_token = "{{ promptStringOnce . "claude_slack_xoxd" "Slack xoxd browser cookie (URL-decoded, starts with xoxd-)" }}"
{{- end }}
{{- end }}

################################################################################
# Download mirrors (e.g. QRT Artifactory). Every outside fetch in these dotfiles
# goes through these values; defaults are the public sources. Asked on Linux only.
# Change later: edit ~/.config/chezmoi/chezmoi.toml, then `chezmoi apply`.
#   github      base for archives + release downloads   (replaces https://github.com)
#   github_api  GitHub REST API (file listings for --folders skills)
#   github_raw  raw file downloads (--folders skills)
#   npm         npm registry URL          ("" = public npm)
#   pypi        PyPI simple index URL     ("" = public PyPI)
#   brew_api    HOMEBREW_API_DOMAIN       ("" = formulae.brew.sh)
#   brew_bottle HOMEBREW_ARTIFACT_DOMAIN  ("" = ghcr.io / GitHub)
################################################################################
{{- $ask := eq .chezmoi.os "linux" }}
{{- $m := dict "github" "https://github.com" "github_api" "https://api.github.com" "github_raw" "https://raw.githubusercontent.com" "npm" "" "pypi" "" "brew_api" "" "brew_bottle" "" }}
{{- if hasKey . "mirror" }}{{ $m = merge (deepCopy .mirror) $m }}{{ end }}
[data.mirror]
    github      = {{ if $ask }}{{ promptStringOnce . "mirror.github" "Mirror for GitHub downloads" $m.github | quote }}{{ else }}{{ $m.github | quote }}{{ end }}
    github_api  = {{ if $ask }}{{ promptStringOnce . "mirror.github_api" "Mirror for api.github.com" $m.github_api | quote }}{{ else }}{{ $m.github_api | quote }}{{ end }}
    github_raw  = {{ if $ask }}{{ promptStringOnce . "mirror.github_raw" "Mirror for raw.githubusercontent.com" $m.github_raw | quote }}{{ else }}{{ $m.github_raw | quote }}{{ end }}
    npm         = {{ if $ask }}{{ promptStringOnce . "mirror.npm" "npm registry URL (empty = public)" $m.npm | quote }}{{ else }}{{ $m.npm | quote }}{{ end }}
    pypi        = {{ if $ask }}{{ promptStringOnce . "mirror.pypi" "PyPI index URL (empty = public)" $m.pypi | quote }}{{ else }}{{ $m.pypi | quote }}{{ end }}
    brew_api    = {{ if $ask }}{{ promptStringOnce . "mirror.brew_api" "HOMEBREW_API_DOMAIN (empty = public)" $m.brew_api | quote }}{{ else }}{{ $m.brew_api | quote }}{{ end }}
    brew_bottle = {{ if $ask }}{{ promptStringOnce . "mirror.brew_bottle" "HOMEBREW_ARTIFACT_DOMAIN (empty = public)" $m.brew_bottle | quote }}{{ else }}{{ $m.brew_bottle | quote }}{{ end }}

[diff]
    pager = "delta"

[merge]
    command = "vimdiff"

################################################################################
# OS Detection Flags
################################################################################

[data.macos]
    enabled = {{ eq .chezmoi.os "darwin" }}

[data.linux]
    enabled = {{ eq .chezmoi.os "linux" }}

[data.windows]
    enabled = {{ eq .chezmoi.os "windows" }}

################################################################################
# KeePassXC Integration (macOS only)
################################################################################
{{- if eq .chezmoi.os "darwin" }}

[keepassxc]
    # No global args: `--all` here would override per-call `--attributes` and
    # make keepassxcAttribute return the full multi-line entry dump, producing
    # invalid JSON in MCP files. Per-attribute lookups (keepassxcAttribute) work
    # for both default and custom string attributes without it.
    database = "/Users/{{ .chezmoi.username }}/Dropbox/PW.kdbx"
{{- end }}
