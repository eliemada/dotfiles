# .chezmoiignore — what NOT to install, per OS and per feature flag.
# Patterns match TARGET paths (relative to ~). Scripts match as
# `.chezmoiscripts/<NN-name>` (the run_*/once/onchange prefixes are stripped).
# See: https://www.chezmoi.io/reference/special-files-and-directories/chezmoiignore/

# Repo-only files
README.md
.claude/settings.local.json

# Junk that must never be captured by `chezmoi add`
**/.DS_Store
**/.venv
**/__pycache__
**/node_modules

################################################################################
# Not macOS
################################################################################
{{- if ne .chezmoi.os "darwin" }}
.Brewfile
# Personal identities & projects (work Linux gets tools only)
.gitconfig-github
.gitconfig-gitlab
.gitconfig-madauto
.config/git/madauto-coauthor.sh
.shrc.d/61-claude-abl.sh
.shrc.d/65-tactics-r2.sh
.chezmoiscripts/50-macos-defaults.sh
.chezmoiscripts/55-macos-dock.sh
# Ghostty config lives under ~/Library on macOS only
Library
# KeePassXC-backed (personal Mac only)
.chezmoiscripts/10-ssh-key-restore.sh
{{- end }}

################################################################################
# Not Linux
################################################################################
{{- if ne .chezmoi.os "linux" }}
.Brewfile.linux
.chezmoiscripts/60-linux-font-cache.sh
{{- end }}

################################################################################
# Not Windows
################################################################################
{{- if ne .chezmoi.os "windows" }}
.chezmoiscripts/*.ps1
.config/scoop
Documents
{{- end }}

################################################################################
# Windows (no POSIX shell setup)
################################################################################
{{- if eq .chezmoi.os "windows" }}
.chezmoiscripts/*.sh
.Brewfile
.Brewfile.linux
.ssh/config
.local/bin
.shrc.d
{{- end }}

################################################################################
# Feature flags (set at `chezmoi init`, stored in ~/.config/chezmoi/chezmoi.toml)
################################################################################
{{- $epfl_vpn := eq .chezmoi.os "darwin" -}}
{{- if hasKey . "epfl_vpn" }}{{ $epfl_vpn = .epfl_vpn }}{{ end }}
{{- if not $epfl_vpn }}
.shrc.d/70-epfl-vpn.sh
{{- end }}

{{- $personal_mcps := eq .chezmoi.os "darwin" -}}
{{- if hasKey . "personal_mcps" }}{{ $personal_mcps = .personal_mcps }}{{ end }}
{{- if not $personal_mcps }}
.claude/mcp-servers/moodle.json
.claude/mcp-servers/edstem.json
{{- end }}

{{- $work_mcps := false -}}
{{- if hasKey . "work_mcps" }}{{ $work_mcps = .work_mcps }}{{ end }}
{{- if not $work_mcps }}
.claude/mcp-servers/atlassian.json
.claude/mcp-servers/slack.json
{{- end }}

# Schedulers: launchd on macOS, systemd on Linux
{{- if ne .chezmoi.os "darwin" }}
Library/LaunchAgents
{{- end }}
{{- if ne .chezmoi.os "linux" }}
.config/systemd
{{- end }}
