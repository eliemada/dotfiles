# .chezmoiignore
# Files to ignore based on OS
# See: https://www.chezmoi.io/reference/special-files-and-directories/chezmoiignore/

################################################################################
# macOS-only files (ignore on Linux and Windows)
################################################################################
{{- if ne .chezmoi.os "darwin" }}

# GitHub identity (personal)
.gitconfig-github

# macOS-specific scripts
run_once_configure-macos.sh
run_once_configure-dock.sh

# Brewfile (Linux uses .Brewfile.linux, Windows uses Scoop)
.Brewfile

# KeePassXC-dependent files (personal password manager)
run_once_after_ssh_key_restore.sh
.ssh/config

{{- end }}

################################################################################
# Linux/macOS only (ignore on Windows)
################################################################################
{{- if eq .chezmoi.os "windows" }}

# Brewfiles (Windows uses Scoop)
.Brewfile
.Brewfile.linux

# SSH config (Windows handles SSH differently)
.ssh/config

{{- end }}

################################################################################
# Windows-only files (ignore on macOS and Linux)
################################################################################
{{- if ne .chezmoi.os "windows" }}

# Scoop config
.config/scoop/

# PowerShell profile
Documents/

{{- end }}

################################################################################
# Opt-in features (toggled by ~/.config/chezmoi/chezmoi.toml)
################################################################################
# EPFL VPN helpers — installed only when `epfl_vpn = true` in chezmoi.toml.
# Default falls back to "macOS only" for installs that predate the flag, so
# existing personal Macs keep working without re-running `chezmoi init`.
{{- $epfl_vpn := eq .chezmoi.os "darwin" -}}
{{- if hasKey . "epfl_vpn" }}{{ $epfl_vpn = .epfl_vpn }}{{ end }}
{{- if not $epfl_vpn }}
.shrc.d/epfl-vpn.sh
{{- end }}

# Claude Code MCP servers — gated by personal_mcps / work_mcps flags.
{{- $personal_mcps := eq .chezmoi.os "darwin" -}}
{{- if hasKey . "personal_mcps" }}{{ $personal_mcps = .personal_mcps }}{{ end }}
{{- $work_mcps := false -}}
{{- if hasKey . "work_mcps" }}{{ $work_mcps = .work_mcps }}{{ end }}
{{- if not $personal_mcps }}
.claude/mcp-servers/moodle.json
.claude/mcp-servers/edstem.json
{{- end }}
{{- if not $work_mcps }}
.claude/mcp-servers/atlassian.json
.claude/mcp-servers/slack.json
{{- end }}
