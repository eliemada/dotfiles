{{- if eq .chezmoi.os "linux" -}}
#!/usr/bin/env bash
################################################################################
# run_once_install_nerd_font.sh.tmpl
# Install JetBrains Mono Nerd Font on Linux
################################################################################
set -euo pipefail

FONT_NAME="JetBrainsMono"
FONT_DIR="$HOME/.local/share/fonts"
FONT_URL="https://github.com/ryanoasis/nerd-fonts/releases/latest/download/JetBrainsMono.zip"

# Check if font is already installed
if fc-list | grep -qi "JetBrainsMono"; then
    echo "JetBrains Mono Nerd Font already installed."
    exit 0
fi

echo "Installing JetBrains Mono Nerd Font..."

# Create font directory
mkdir -p "$FONT_DIR"

# Download and extract
TEMP_DIR=$(mktemp -d)
cd "$TEMP_DIR"

echo "Downloading from $FONT_URL..."
curl -fsSL -o "${FONT_NAME}.zip" "$FONT_URL"

echo "Extracting..."
unzip -q "${FONT_NAME}.zip" -d "$FONT_DIR"

# Refresh font cache
echo "Refreshing font cache..."
fc-cache -f "$FONT_DIR"

# Cleanup
rm -rf "$TEMP_DIR"

echo "JetBrains Mono Nerd Font installed successfully."
{{- end }}
