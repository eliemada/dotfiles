{{/*
  claude-mcp-secret  —  resolve an MCP secret across machines (apply-time).

  Usage:
    {{ template "claude-mcp-secret" (dict "entry" "edstem" "field" "Password") }}

  Backends:
    - macOS: reads from KeePassXC entry "Claude/<entry>", attribute <field>
             (works for predefined attrs Password/URL/UserName and custom strings).
    - other: reads from chezmoi data set at `chezmoi init` time:
             `.claude_secrets.<entry>.<field>` (see .chezmoi.toml.tmpl for the
             promptStringOnce wiring).

  Plaintext warning: on non-macOS, secrets live in ~/.config/chezmoi/chezmoi.toml
  in plaintext (mode 0600). Acceptable for personal use; for corp environments
  configure chezmoi `[secret]` with a custom command (op / keeper / secret-tool)
  and rewrite this template against that.
*/ -}}
{{- if .macos.enabled -}}
{{- keepassxcAttribute (printf "Claude/%s" .entry) .field -}}
{{- else -}}
{{- if and (hasKey . "claude_secrets") (hasKey (index . "claude_secrets") .entry) -}}
{{- index .claude_secrets .entry .field -}}
{{- else -}}
{{- /* not yet initialized for this entry — render empty so the JSON file is empty and reconciliation skips it */ -}}
{{- end -}}
{{- end -}}
