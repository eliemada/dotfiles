################################################################################
# ~/.gitconfig (template)
# Global Git configuration with conditional includes
################################################################################
[user]
	name = {{ .name | quote }}
	email = {{ .email | quote }}

{{- if eq .chezmoi.os "darwin" }}
# Personal identities per remote (Mac only). On work machines (QRT) user.email
# above is the work address entered at `chezmoi init`.
[includeIf "hasconfig:remote.*.url:https://github.com/**"]
	path = ~/.gitconfig-github

[includeIf "hasconfig:remote.*.url:https://**gitlab**/**"]
	path = ~/.gitconfig-gitlab

[includeIf "hasconfig:remote.*.url:git@**gitlab**:*/**"]
    path = ~/.gitconfig-gitlab

[includeIf "hasconfig:remote.*.url:git@github.com:*/**"]
	path = ~/.gitconfig-github

[includeIf "hasconfig:remote.*.url:git@github-madauto:*/**"]
	path = ~/.gitconfig-madauto
{{- end }}

[core]
	editor = "nano"
	excludesfile = ~/.gitignore_global
	autocrlf = input

[init]
	defaultBranch = main

[pull]
	rebase = false

[color]
	ui = auto
