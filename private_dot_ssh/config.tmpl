################################################################################
# ~/.ssh/config  —  managed by chezmoi (edit private_dot_ssh/config.tmpl)
#
# Shared defaults only. Machine-specific hosts (servers, work/QRT internal hosts)
# go in ~/.ssh/config.d/<name> — NOT tracked by chezmoi, never pushed.
################################################################################

# Must come first: ssh keeps the first value it sees, so local host blocks
# override the Host * defaults below.
Include ~/.ssh/config.d/*

{{- if eq .chezmoi.os "darwin" }}

# github-madauto resolves to github.com, so it needs its own multiplexing socket;
# otherwise it reuses an open eliemada connection (ssh uses the first value set).
Host github-madauto
    ControlPath ~/.ssh/control/github-madauto-%C
{{- end }}

################################################################################
# Defaults for every host
################################################################################
Host *
    AddKeysToAgent yes
{{- if eq .chezmoi.os "darwin" }}
    UseKeychain yes
{{- end }}

    # Privacy: hash hostnames in known_hosts so a leak doesn't reveal targets
    HashKnownHosts yes

    # Liveness: keepalive every 60s, drop after 3 missed (~3 min)
    ServerAliveInterval 60
    ServerAliveCountMax 3

    # Multiplexing: reuse one TCP session across ssh / scp / rsync / git
    ControlMaster auto
    ControlPath ~/.ssh/control/%C
    ControlPersist 10m
{{- if eq .chezmoi.os "darwin" }}

################################################################################
# Personal git hosting (Mac only; keys restored from KeePassXC)
################################################################################
Host github.com
    HostName github.com
    User git
    IdentityFile {{ keepassxcAttribute "config/ssh/github.com" "SSHKeyPath" }}
    IdentitiesOnly yes

# Madauto account: remotes use git@github-madauto:madauto-mg/<repo>.git
Host github-madauto
    HostName github.com
    User git
    IdentityFile ~/.ssh/id_ed25519_github_madauto
    IdentitiesOnly yes

Host gitlab.epfl.ch
    HostName gitlab.epfl.ch
    User git
    IdentityFile {{ keepassxcAttribute "config/ssh/gitlab.epfl.ch" "SSHKeyPath" }}
    IdentitiesOnly yes
{{- end }}
