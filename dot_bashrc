################################################################################
# ~/.bashrc
# Bash startup: source shared snippets and includes
################################################################################

# Shared snippets: ~/.shrc.d, sourced in filename order (same as zsh).
for file in ~/.shrc.d/*.sh.pre ~/.shrc.d/*.sh ~/.shrc.d/*.bash; do
  [ -r "$file" ] && . "$file"
done

################################################################################
# Zoxide (MUST be last to override cd properly)
################################################################################
if command -v zoxide > /dev/null 2>&1; then
  eval "$(zoxide init bash --cmd cd)"
fi
