#!/usr/bin/env bash
################################################################################
# claude-update — keep Claude Code + skills + plugins current (Mac and Linux).
#
# Runs daily from launchd (macOS) / systemd user timer (Linux); safe by hand.
#   claude-update            update everything, log to ~/.local/state/claude-update.log
#   claude-update --verbose  same, but also print to the terminal
#
# Steps (each one independent; a failure is logged and the rest still run):
#   1. Claude Code binary (chezmoi external)
#   2. Skill packages from ~/.config/claude-update/skills.txt (archive download, via mirror)
#   3. Own skills that are git clones in ~/.claude/skills (git pull --ff-only)
#   4. Plugin marketplaces + every installed plugin (needs GitHub; skipped behind a mirror)
# Changes to ~/.claude/settings.json made by plugin updates are reported, not
# auto-committed: capture them with `claude-settings-capture` (on the Mac).
################################################################################
set -uo pipefail

STATE_DIR="${XDG_STATE_HOME:-$HOME/.local/state}"
LOG="$STATE_DIR/claude-update.log"
LOCK="$STATE_DIR/claude-update.lock"
SKILLS_LIST="$HOME/.config/claude-update/skills.txt"
SKILLS_DIR="$HOME/.claude/skills"
SETTINGS="$HOME/.claude/settings.json"
mkdir -p "$STATE_DIR"

# launchd/systemd start with a bare PATH
. "$HOME/.shrc.d/01-homebrew.sh.pre" 2>/dev/null || true
. "$HOME/.shrc.d/02-mirrors.sh.pre" 2>/dev/null || true   # GitHub/npm mirrors
export PATH="$HOME/.local/bin:$PATH"

if [[ "${1:-}" == "--verbose" || -t 1 ]]; then
  exec > >(tee -a "$LOG") 2>&1
else
  exec >>"$LOG" 2>&1
fi

if ! mkdir "$LOCK" 2>/dev/null; then
  echo "$(date '+%F %T') another claude-update is running; exiting"; exit 0
fi
trap 'rmdir "$LOCK"' EXIT

FAILED=()
step() {
  local name=$1; shift
  echo "-- $name"
  if ! "$@"; then FAILED+=("$name"); echo "!! $name failed"; fi
}
has() { command -v "$1" >/dev/null 2>&1; }

update_externals() {
  has chezmoi || { echo "chezmoi missing"; return 1; }
  chezmoi apply --force --refresh-externals=always "$HOME/.local/bin/claude"
}

# Skill packages listed in ~/.config/claude-update/skills.txt (see skill-sync --help
# in its docstring): whole-repo archive or only the needed folders, via the mirror.
update_skill_packages() {
  python3 "$HOME/.local/bin/skill-sync"
}

update_git_skills() {
  local d
  for d in "$SKILLS_DIR"/*/.git; do
    [[ -e "$d" ]] || continue
    d=${d%/.git}
    echo "git pull $(basename "$d")"
    git -C "$d" pull --ff-only -q || return 1
  done
}

# Plugins are synced through settings.json (chezmoi): enabledPlugins + extraKnownMarketplaces.
# On a machine that lacks one, add its marketplace and install it. Plugins set to false
# (enabled per project only) are installed too, so `enable --scope project` just works.
ensure_plugins() {
  local want have line rc=0
  have=$(claude plugin list --json 2>/dev/null | python3 -c 'import json,sys; print("\n".join(p["id"] for p in json.load(sys.stdin)))')
  while IFS=$'\t' read -r kind a b; do
    case $kind in
      market) claude plugin marketplace list 2>/dev/null | grep -q "❯ $a\b" \
                || { echo "adding marketplace $a ($b)"; claude plugin marketplace add "$b" || rc=1; } ;;
      plugin) grep -qx "$a" <<<"$have" \
                || { echo "installing plugin $a"; claude plugin install "$a" </dev/null || rc=1; } ;;
    esac
  done < <(python3 - "$SETTINGS" <<'PY'
import json, sys
s = json.load(open(sys.argv[1]))
for name, m in s.get("extraKnownMarketplaces", {}).items():
    src = m.get("source", {})
    if src.get("source") == "github":
        print(f"market\t{name}\t{src['repo']}")
for pid in s.get("enabledPlugins", {}):
    print(f"plugin\t{pid}\t")
PY
)
  # claude-hud: statusLine runs a fixed-path launcher; refresh it from the installed plugin
  local hud
  hud=$(ls -d "$HOME"/.claude/plugins/cache/claude-hud/claude-hud/*/scripts/statusline.mjs 2>/dev/null | sort -V | tail -1)
  if [[ -n "$hud" ]]; then
    mkdir -p "$HOME/.claude/plugins/claude-hud" && cp "$hud" "$HOME/.claude/plugins/claude-hud/statusline.mjs"
  fi
  return $rc
}

update_plugins() {
  has claude || { echo "claude missing"; return 1; }
  local rc=0
  # Marketplaces are git repos on GitHub; behind a download-only mirror they
  # can't be refreshed, so don't report a daily failure for it.
  if [[ "${DOTFILES_GITHUB_BASE:-https://github.com}" != "https://github.com" ]]; then
    echo "mirror mode: plugin updates skipped (marketplaces need GitHub git access)"; return 0
  fi
  ensure_plugins || rc=1
  claude plugin marketplace update || return 1
  local id
  for id in $(claude plugin list --json 2>/dev/null | python3 -c 'import json,sys; print("\n".join(p["id"] for p in json.load(sys.stdin)))'); do
    [[ "$id" == *@skills-dir ]] && continue   # loaded from ~/.claude/skills, updated by skill-sync
    claude plugin update "$id" </dev/null || { echo "plugin $id: update failed"; rc=1; }
  done
  return $rc
}

echo
echo "=== $(date '+%F %T') claude-update on $(hostname -s)"
before=$(cksum "$SETTINGS" 2>/dev/null)

step "claude binary + externals" update_externals
step "skill packages"            update_skill_packages
step "git skills"                update_git_skills
step "plugins"                   update_plugins

if [[ -n "$before" && "$before" != "$(cksum "$SETTINGS" 2>/dev/null)" ]]; then
  echo "NOTE: ~/.claude/settings.json was changed by an installer."
  echo "      Run claude-settings-capture to keep it, or chezmoi apply to revert."
fi

if ((${#FAILED[@]})); then
  echo "=== done with failures: ${FAILED[*]}"; exit 1
fi
echo "=== done"
