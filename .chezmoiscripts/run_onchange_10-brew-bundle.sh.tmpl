#!/usr/bin/env bash
################################################################################
# run_onchange_brew_bundle.sh.tmpl
# Keep Homebrew apps in sync with Brewfile when it changes
# Supports macOS (full Brewfile) and Linux (CLI-only Brewfile.linux)
# Re-run trigger (changes whenever a Brewfile changes):
# .Brewfile       {{ include "dot_Brewfile" | sha256sum }}
# .Brewfile.linux {{ include "dot_Brewfile.linux" | sha256sum }}
################################################################################
set -euo pipefail

OS="{{ .chezmoi.os }}"

# Only run on macOS or Linux
if [ "$OS" != "darwin" ] && [ "$OS" != "linux" ]; then
  exit 0
fi

# Ensure Homebrew is available in PATH
if ! command -v brew >/dev/null 2>&1; then
  if [ "$OS" = "darwin" ]; then
    # macOS Homebrew paths
    if [ -x /opt/homebrew/bin/brew ]; then
      eval "$(/opt/homebrew/bin/brew shellenv)"
    elif [ -x /usr/local/bin/brew ]; then
      eval "$(/usr/local/bin/brew shellenv)"
    else
      echo "Homebrew not found. Installing Homebrew..."
      /bin/bash -c "$(curl -fsSL https://raw.githubusercontent.com/Homebrew/install/HEAD/install.sh)"
      if [ -x /opt/homebrew/bin/brew ]; then
        eval "$(/opt/homebrew/bin/brew shellenv)"
      elif [ -x /usr/local/bin/brew ]; then
        eval "$(/usr/local/bin/brew shellenv)"
      fi
    fi
  elif [ "$OS" = "linux" ]; then
    # Linuxbrew path
    if [ -x /home/linuxbrew/.linuxbrew/bin/brew ]; then
      eval "$(/home/linuxbrew/.linuxbrew/bin/brew shellenv)"
    elif [ -x "$HOME/.linuxbrew/bin/brew" ]; then
      eval "$("$HOME/.linuxbrew/bin/brew" shellenv)"
    else
      echo "Homebrew not found. Installing Linuxbrew..."
{{- if eq .mirror.github "https://github.com" }}
      NONINTERACTIVE=1 /bin/bash -c "$(curl -fsSL https://raw.githubusercontent.com/Homebrew/install/HEAD/install.sh)"
{{- else }}
      # Mirror mode: no git access, so use Homebrew's "untar anywhere" install
      # into the standard prefix (keeps prebuilt bottles usable).
      PREFIX=/home/linuxbrew/.linuxbrew
      sudo mkdir -p "$PREFIX/Homebrew" && sudo chown -R "$(id -un)" /home/linuxbrew
      curl -fsSL "{{ .mirror.github }}/Homebrew/brew/archive/HEAD.tar.gz" \
        | tar xz --strip-components 1 -C "$PREFIX/Homebrew"
      mkdir -p "$PREFIX/bin" && ln -sf ../Homebrew/bin/brew "$PREFIX/bin/brew"
{{- end }}
      if [ -x /home/linuxbrew/.linuxbrew/bin/brew ]; then
        eval "$(/home/linuxbrew/.linuxbrew/bin/brew shellenv)"
      elif [ -x "$HOME/.linuxbrew/bin/brew" ]; then
        eval "$("$HOME/.linuxbrew/bin/brew" shellenv)"
      fi
    fi
  fi
fi

# Mirror settings (npm/pypi/Homebrew API + bottles) from chezmoi data
. "$HOME/.shrc.d/02-mirrors.sh.pre" 2>/dev/null || true

# Select appropriate Brewfile based on OS
if [ "$OS" = "darwin" ]; then
  BREWFILE="$HOME/.Brewfile"
elif [ "$OS" = "linux" ]; then
  BREWFILE="$HOME/.Brewfile.linux"
fi

if [ -f "$BREWFILE" ]; then
  echo "Running brew bundle using $BREWFILE ..."
  brew bundle --file="$BREWFILE"
else
  echo "Warning: $BREWFILE not found; nothing to bundle."
fi
